{
  "name": "mcp-commerce-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server that lets AI assistants work with a store safely: scoped API keys, PII minimisation, preview-then-confirm for every write, rate limits and an audit log.",
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test -- --coverage && npm run build",
    "http": "tsx src/http.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndanetaadmire-debug/mcp-commerce-server.git"
  },
  "author": "Admire T. Ndaneta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ndanetaadmire-debug/mcp-commerce-server/issues"
  },
  "homepage": "https://github.com/ndanetaadmire-debug/mcp-commerce-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "mcp-commerce-server": "dist/stdio.js"
  }
}
